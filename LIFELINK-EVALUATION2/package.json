    "db:restore": "node server/src/utils/restoreDatabase.js",
    "test": "node server/tests/auth.test.js && node server/tests/donor.test.js && node server/tests/hospital_requests.test.js && node server/tests/matcher.test.js && node server/tests/invitations.test.js && node server/tests/notifications_escalation.test.js && node server/tests/e2e_production_lifecycle.test.js && node server/tests/new_bug_fixes.test.js",
    "test:auth": "node server/tests/auth.test.js",
    "test:donor": "node server/tests/donor.test.js",
    "test:hospital": "node server/tests/hospital_requests.test.js",
    "test:matcher": "node server/tests/matcher.test.js",
    "test:invitations": "node server/tests/invitations.test.js",
    "test:notifications": "node server/tests/notifications_escalation.test.js",
    "test:e2e": "node server/tests/e2e_production_lifecycle.test.js",
    "test:bugs": "node server/tests/new_bug_fixes.test.js"
