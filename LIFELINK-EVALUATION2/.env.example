# =====================================================
# LIFELINK — ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================

# Server Configuration
PORT=5000
NODE_ENV=development # Set to 'production' for live deployment

# Database Configuration (MongoDB Atlas or Local MongoDB Replica Set)
MONGODB_URI=mongodb://127.0.0.1:27017/lifelink

# Authentication & Session Security
JWT_SECRET=lifelink_dev_secret_key_2026_super_secure_node_jwt # High-entropy 64+ char secret for production
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple client domains)
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://localhost:5000

# Rate Limiting & Abuse Prevention (Optional Override)
DISABLE_RATE_LIMIT=false

# External Transactional Email Service (Optional for Production Email Deliveries)
# When omitted, LifeLink operates in simulated/logged mode for zero-cost demo environments
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key_here
# EMAIL_FROM=notifications@lifelink.internal
